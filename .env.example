# Copy the lines you need into your shell. The scripts read the environment; they do not load this file.
# Nothing here is needed for the recorded path in the README.

# Meta Model API key, only for live Muse Spark calls (rescue.py --l1, l1_context.py, e4_spark_labels.py).
export MODEL_API_KEY=

# Optional: the Spark model id, if your key has no access to the default contributor tier.
# export SPARK_MODEL=muse-spark-1.3-contributor

# Optional: Hugging Face token, only to download the gated facebook/sam3 base weights.
# export HF_TOKEN=
